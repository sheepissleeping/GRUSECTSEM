write.csv(drift_summary,
          file.path(config$save_path,"DRIFT_summary.csv"), row.names=FALSE)
write.csv(drift_df,
          file.path(config$save_path,"DRIFT_all_boots.csv"), row.names=FALSE)
if(!is.null(tipred_summary)) {
    write.csv(tipred_summary,
              file.path(config$save_path,"TIpred_summary.csv"), row.names=FALSE)
    write.csv(tipred_df,
              file.path(config$save_path,"TIpred_all_boots.csv"), row.names=FALSE)
}
cat("\n✅ CSV已保存至:", config$save_path, "\n")

# =============================================================================
# 第5步：可视化
# =============================================================================
cat("\n══ 生成图表 ══\n")

# 图1：DRIFT分布
tryCatch({
    drift_long <- drift_df %>%
        pivot_longer(c(drift_PP,drift_AA,drift_PA,drift_AP),
                     names_to="param", values_to="value") %>%
        mutate(param=recode(param,
            drift_PP="P_P（P自回归）", drift_AA="A_A（A自回归）",
            drift_PA="P_A（P→A）",    drift_AP="A_P（A→P）"))
    ref_df <- data.frame(
        param=c("P_P（P自回归）","A_A（A自回归）","P_A（P→A）","A_P（A→P）"),
        ref  =c(res_full$drift$drift_PP,res_full$drift$drift_AA,
                res_full$drift$drift_PA,res_full$drift$drift_AP))
    p1 <- ggplot(drift_long,aes(x=value)) +
        geom_histogram(fill="#3C5488",alpha=.75,bins=20,color="white") +
        geom_vline(data=ref_df,aes(xintercept=ref),
                   color="red",linetype="dashed",linewidth=1) +
        facet_wrap(~param,scales="free",ncol=2) +
        labs(title=sprintf("Bootstrap DRIFT参数分布（n=%d次成功，N=30）",n_success),
             subtitle="红虚线=原始完整样本估计值",x="参数估计值",y="频数") +
        theme_minimal(base_size=13) +
        theme(plot.title=element_text(hjust=.5,face="bold"),
              strip.text=element_text(face="bold"))
    ggsave(file.path(config$save_path,"plots","01_DRIFT_distribution.png"),
           p1,width=12,height=8,dpi=300)
    cat("  ✅ 01_DRIFT_distribution.png\n")
}, error=function(e) cat("  ❌",e$message,"\n"))

# 图2：TIpred置信区间（4个target分面）
if(!is.null(tipred_summary)) {
    tryCatch({
        p2 <- tipred_summary %>%
            mutate(
                sig_label = ifelse(isTRUE(sig),"★显著","不显著"),
                target    = factor(target, levels=c("P_P","A_A","P_A","A_P"))
            ) %>%
            ggplot(aes(x=reorder(predictor,boot_mean),
                       y=boot_mean, color=sig_label)) +
            geom_hline(yintercept=0,linetype="dashed",color="gray50") +
            geom_errorbar(aes(ymin=ci_lo95,ymax=ci_hi95),
                          width=.3,linewidth=.9) +
            geom_point(size=3) +
            scale_color_manual(
                values=c("★显著"="#E74C3C","不显著"="gray60")) +
            facet_wrap(~target,ncol=2,scales="free_x") +
            coord_flip() +
            labs(title="大五人格+年龄+性别对情绪动态的影响（Bootstrap 95% CI）",
                 subtitle=sprintf("N=30，%d次Bootstrap，探索性分析",n_success),
                 x="",y="效应量（标准化）",color="") +
            theme_bw(base_size=12) +
            theme(legend.position="bottom",
                  plot.title=element_text(hjust=.5,face="bold"),
                  strip.text=element_text(face="bold",size=11))
        ggsave(file.path(config$save_path,"plots","02_TIpred_CI.png"),
               p2,width=13,height=10,dpi=300)
        cat("  ✅ 02_TIpred_CI.png\n")
    }, error=function(e) cat("  ❌",e$message,"\n"))

    # 图3：方向一致性热图
    tryCatch({
        p3 <- tipred_summary %>%
            mutate(
                dg = case_when(
                    dir_pct>=90 ~ "≥90%（高）",
                    dir_pct>=75 ~ "75-90%（中）",
                    TRUE        ~ "<75%（低）"),
                dg     = factor(dg,levels=c("≥90%（高）","75-90%（中）","<75%（低）")),
                target = factor(target,levels=c("P_P","A_A","P_A","A_P"))
            ) %>%
            ggplot(aes(x=target,y=predictor,fill=dg)) +
            geom_tile(color="white",linewidth=.8) +
            geom_text(aes(label=sprintf("%.0f%%\n%.3f",dir_pct,boot_mean)),
                      size=3.2) +
            scale_fill_manual(values=c(
                "≥90%（高）"   ="#00A087",
                "75-90%（中）" ="#F39B7F",
                "<75%（低）"   ="#E64B35")) +
            labs(title="Bootstrap方向一致性热图（数字=方向%/Boot均值）",
                 subtitle="探索性分析：展示效应方向跨样本的稳定程度",
                 x="目标参数",y="预测变量",fill="方向一致性") +
            theme_minimal(base_size=12) +
            theme(plot.title=element_text(hjust=.5,face="bold"))
        ggsave(file.path(config$save_path,"plots","03_direction_heatmap.png"),
               p3,width=10,height=7,dpi=300)
        cat("  ✅ 03_direction_heatmap.png\n")
    }, error=function(e) cat("  ❌",e$message,"\n"))
}

# =============================================================================
# 完成
# =============================================================================
cat("\n══════════════════════════════════════════\n")
cat(sprintf("  完成！成功%d / 失败%d\n", n_success, n_fail))
cat(sprintf("  总耗时：%.1f分钟\n", t_total))
cat(sprintf("  结果：%s\n", config$save_path))
cat("  输出文件：\n")
cat("    DRIFT_summary.csv      — DRIFT参数汇总\n")
cat("    DRIFT_all_boots.csv    — DRIFT每次原始值\n")
cat("    TIpred_summary.csv     — TI效应汇总（28行=7×4，无重复）\n")
cat("    TIpred_all_boots.csv   — TI效应每次原始值\n")
cat("    plots/01~03.png        — 可视化图表\n")
cat("══════════════════════════════════════════\n")
if(config$n_boot <= 5) {
    cat("\n★ 当前为测试模式（n_boot=", config$n_boot, "）\n")
    cat("  确认结果正确后，将代码顶部改为：\n")
    cat("    n_boot         = 50\n")
    cat("    finish_samples = 200\n")
    cat("  删除boot_partial.rds后重新运行完整版\n")
}
