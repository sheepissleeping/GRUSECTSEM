# ── 图1：TIPRED效应 Bootstrap 95%CI 森林图 ──
tryCatch({
    plot_df <- tipred_boot_summary %>%
        mutate(
            predictor_label = recode(predictor,
                age="年龄", gender="性别",
                PC1="PC1(人格因子1)", PC2="PC2(人格因子2)"),
            target_label = ifelse(target=="eta_P","η_P 正向情绪","η_A 负向情绪"),
            sig_label    = ifelse(sig,"显著（CI不含0）","不显著")
        )

    p1 <- ggplot(plot_df,
                 aes(x=reorder(predictor_label, boot_mean),
                     y=boot_mean, color=sig_label)) +
        geom_hline(yintercept=0, linetype="dashed", color="gray50", linewidth=0.8) +
        geom_errorbar(aes(ymin=ci_lo95, ymax=ci_hi95),
                      width=0.25, linewidth=0.9) +
        geom_point(aes(shape=sig_label), size=3.5, fill="white") +
        geom_point(data=plot_df %>% rename(orig=original),
                   aes(y=orig), shape=4, size=2.5, color="gray40") +
        scale_color_manual(values=c("显著（CI不含0）"="#C0392B","不显著"="gray55")) +
        scale_shape_manual(values=c("显著（CI不含0）"=16,"不显著"=21)) +
        coord_flip() +
        facet_wrap(~target_label, ncol=2) +
        labs(
            title    = "Time-Invariant Predictor Effects on Latent Processes",
            subtitle = sprintf("Bootstrap 95%% CI (n=%d resamples); ×=original estimate", n_success),
            x        = "Predictor",
            y        = "Effect Size (Standardized)",
            color    = "Significance",
            shape    = "Significance"
        ) +
        theme_bw(base_size=13) +
        theme(
            plot.title    = element_text(hjust=.5, face="bold", size=14),
            plot.subtitle = element_text(hjust=.5, color="gray40", size=11),
            legend.position = "bottom",
            strip.text      = element_text(face="bold", size=12),
            panel.grid.minor = element_blank()
        )

    ggsave(file.path(config$save_path,"plots","Fig1_TIpred_ForestPlot.png"),
           p1, width=12, height=7, dpi=300)
    cat("  ✅ Fig1_TIpred_ForestPlot.png\n")
}, error=function(e) cat("  ❌ 森林图:", e$message,"\n"))

# ── 图2：Drift参数 Bootstrap分布 ──
tryCatch({
    drift_long <- drift_df %>%
        pivot_longer(c(drift_PP,drift_AA,drift_PA,drift_AP),
                     names_to="param", values_to="value") %>%
        mutate(param = recode(param,
            drift_PP="P→P (Auto-regression)",
            drift_AA="A→A (Auto-regression)",
            drift_PA="P→A (Cross-lagged)",
            drift_AP="A→P (Cross-lagged)"))

    ci_df <- drift_boot_summary %>%
        mutate(param = recode(parameter,
            "P→P(自回归)"="P→P (Auto-regression)",
            "A→A(自回归)"="A→A (Auto-regression)",
            "P→A(交叉)"  ="P→A (Cross-lagged)",
            "A→P(交叉)"  ="A→P (Cross-lagged)"))

    p2 <- ggplot(drift_long, aes(x=value)) +
        geom_histogram(aes(y=after_stat(density)),
                       bins=25, fill="#2C3E7A", alpha=.75, color="white") +
