# =============================================================================
# CT-SEM Bootstrap 最终正确版
# ✅ 基于s$tipreds（已确认有效）
# ✅ 参数名映射规则（已从诊断数据确认）：
#     tip_X_drift_eta_P       → P_P（P自回归）
#     tip_X_drift_eta_A       → A_A（A自回归）
#     tip_X_drift_eta_P_eta_A → A_P（A→P交叉）
#     tip_X_drift_eta_A_eta_P → P_A（P→A交叉）
# ✅ 7预测变量 × 4目标 = 28行，无重复
# ✅ 断点续存 + 分层Bootstrap
# =============================================================================

suppressPackageStartupMessages({
    library(readxl); library(dplyr); library(tidyr)
    library(ggplot2); library(ctsem); library(zoo)
})

# =============================================================================
# 配置
# 测试模式：n_boot=3, finish_samples=50（约20分钟）
# 正式模式：n_boot=50, finish_samples=200（约8-12小时）
# =============================================================================
config <- list(
    data_path      = "D:/data.xlsx",
    save_path      = "C:/Users/48538/Desktop/sanxiu",
    n_boot         = 50,     # 正式版
    base_seed      = 2025,
    smooth_window  = 3,
    finish_samples = 200     # 正式版
)
USE_STRATIFIED <- TRUE

if(!dir.exists(config$save_path)) dir.create(config$save_path, recursive=TRUE)
if(!dir.exists(file.path(config$save_path,"plots")))
    dir.create(file.path(config$save_path,"plots"))

# =============================================================================
# 数据加载
# =============================================================================
cat("══ 加载数据 ══\n")
dat_raw <- read_excel(config$data_path) %>%
    rename(id=name, time=start_second,
           Neuroticism=Negative_Emotionality, Openness=Open_Mindedness) %>%
    mutate(id=as.character(id), time=as.numeric(time)) %>%
    filter(complete.cases(P, A, id, time))

dat <- dat_raw %>% group_by(id) %>% arrange(time) %>%
    mutate(
        P_smooth = zoo::rollmean(P, k=config$smooth_window, fill="extend"),
        A_smooth = zoo::rollmean(A, k=config$smooth_window, fill="extend")
    ) %>% ungroup()

unique_ids <- unique(dat$id)
N <- length(unique_ids)
cat(sprintf("✅ %d观测, %d个体\n\n", nrow(dat), N))

TI_COVS <- c("age","gender","Extraversion","Agreeableness",
             "Conscientiousness","Neuroticism","Openness")

# 固定标准化参数
std_params <- list(
    P_mean=mean(dat$P_smooth), P_sd=sd(dat$P_smooth),
    A_mean=mean(dat$A_smooth), A_sd=sd(dat$A_smooth),
    age_mean=mean(dat$age), age_sd=sd(dat$age),
    gender_mean=mean(dat$gender),
    E_mean=mean(dat$Extraversion),        E_sd=sd(dat$Extraversion),
    Agr_mean=mean(dat$Agreeableness),     Agr_sd=sd(dat$Agreeableness),
    Con_mean=mean(dat$Conscientiousness), Con_sd=sd(dat$Conscientiousness),
    Neu_mean=mean(dat$Neuroticism),       Neu_sd=sd(dat$Neuroticism),
    Ope_mean=mean(dat$Openness),          Ope_sd=sd(dat$Openness)
)

prepare_ctsem_data <- function(dat_sub) {
    dat_sub %>% mutate(
        P = (P_smooth - std_params$P_mean) / std_params$P_sd,
        A = (A_smooth - std_params$A_mean) / std_params$A_sd,
        age    = (age    - std_params$age_mean) / std_params$age_sd,
        gender = gender  - std_params$gender_mean,
        Extraversion      = (Extraversion      - std_params$E_mean)   / std_params$E_sd,
        Agreeableness     = (Agreeableness     - std_params$Agr_mean) / std_params$Agr_sd,
        Conscientiousness = (Conscientiousness - std_params$Con_mean) / std_params$Con_sd,
        Neuroticism       = (Neuroticism       - std_params$Neu_mean) / std_params$Neu_sd,
        Openness          = (Openness          - std_params$Ope_mean) / std_params$Ope_sd
    ) %>% select(id, time, P, A, all_of(TI_COVS)) %>% as.data.frame()
}

# =============================================================================
# ★ TIPRED提取函数（基于诊断确认的参数名规律）
#
# 已确认的参数名 → target 映射：
#   tip_X_drift_eta_P       → P_P  (P自回归，DRIFT[1,1])
#   tip_X_drift_eta_A       → A_A  (A自回归，DRIFT[2,2])
#   tip_X_drift_eta_P_eta_A → A_P  (A→P交叉，DRIFT[1,2])
#   tip_X_drift_eta_A_eta_P → P_A  (P→A交叉，DRIFT[2,1])
#
# 旧版错误根源：把eta_P和eta_P_eta_A都映射到了同一个target
# =============================================================================
extract_tipred <- function(fit_summary) {
    tp_raw <- tryCatch({
        tp <- as.data.frame(fit_summary$tipreds)
        if(is.null(tp) || nrow(tp)==0) return(NULL)
        tp$parameter <- rownames(tp)
        tp$value     <- tp$mean   # s$tipreds里均值列名是"mean"
        tp
    }, error=function(e) { cat("    ❌ s$tipreds提取失败:", e$message, "\n"); NULL })

    if(is.null(tp_raw)) return(NULL)

    # 只保留drift相关参数
    tp_drift <- tp_raw %>% filter(grepl("_drift_", parameter))
    if(nrow(tp_drift) == 0) { cat("    ❌ 无drift参数\n"); return(NULL) }

    # ★ 精确映射（已通过诊断数据确认）
    # 注意：必须先匹配双eta（更长的后缀），再匹配单eta
    tp_mapped <- tp_drift %>%
        mutate(
            predictor = sub("^tip_(.+)_drift_.*$", "\\1", parameter),
            target = case_when(
                # 双eta在前（防止被单eta规则误匹配）
                grepl("_drift_eta_P_eta_A$", parameter) ~ "A_P",  # A→P交叉
                grepl("_drift_eta_A_eta_P$", parameter) ~ "P_A",  # P→A交叉
                # 单eta在后
                grepl("_drift_eta_P$",       parameter) ~ "P_P",  # P自回归
                grepl("_drift_eta_A$",       parameter) ~ "A_A",  # A自回归
                TRUE ~ "other"
            )
        ) %>%
        filter(target != "other", predictor %in% TI_COVS) %>%
        select(parameter, predictor, target, value)

    # 验证：应有7×4=28行，无重复
    n_actual   <- nrow(tp_mapped)
    n_expected <- length(TI_COVS) * 4

    # 检查重复
    dup_check <- tp_mapped %>%
        group_by(predictor, target) %>%
        summarise(n=n(), .groups="drop") %>%
        filter(n > 1)

    if(nrow(dup_check) > 0) {
        cat("    ⚠️ 有重复！强制去重\n")
        tp_mapped <- tp_mapped %>%
            group_by(predictor, target) %>%
            slice(1) %>% ungroup()
        n_actual <- nrow(tp_mapped)
    }

    status <- ifelse(n_actual == n_expected,
                     sprintf("✅ %d行（7×4，无重复）", n_actual),
                     sprintf("⚠️ %d行（预期%d）", n_actual, n_expected))
    cat(sprintf("    TIPRED: %s\n", status))

    return(tp_mapped)
}

# =============================================================================
# 核心拟合函数
# =============================================================================
fit_one <- function(model_data, finish_samples=200, is_full=FALSE) {
    tryCatch({
        mod <- ctModel(
            type='stanct', n.latent=2, n.manifest=2, LAMBDA=diag(2),
            manifestNames=c('P','A'), latentNames=c('eta_P','eta_A'),
            TIpredNames=TI_COVS, id='id', time='time'
        )
        fit <- ctStanFit(
            datalong=model_data, ctstanmodel=mod, optimize=TRUE,
            optimcontrol=list(stochastic=FALSE, finishsamples=finish_samples),
            cores=1, nopriors=TRUE, verbose=0
        )
        s  <- summary(fit)
        pm <- as.data.frame(s$parmatrices)
        dm <- pm %>% filter(matrix=="DRIFT")

        drift <- data.frame(
            drift_PP = dm$Mean[dm$row==1 & dm$col==1],
            drift_AA = dm$Mean[dm$row==2 & dm$col==2],
            drift_PA = dm$Mean[dm$row==2 & dm$col==1],
            drift_AP = dm$Mean[dm$row==1 & dm$col==2]
        )

        tipred <- extract_tipred(s)

        if(is_full && !is.null(tipred)) {
            cat("\n  原始样本TIPRED完整结果（28行）：\n")
            print(tipred %>%
                  mutate(target=factor(target,levels=c("P_P","A_A","P_A","A_P"))) %>%
                  arrange(target, predictor) %>%
                  select(predictor, target, value) %>%
                  as.data.frame())
            cat("\n")
        }

        list(drift=drift, tipred=tipred, success=TRUE)
    }, error=function(e)
        list(drift=NULL, tipred=NULL, success=FALSE, error=e$message))
}

# =============================================================================
# Bootstrap样本生成
# =============================================================================
create_boot_sample <- function(b) {
    set.seed(config$base_seed + b)
    if(USE_STRATIFIED) {
        pn  <- dat %>% group_by(id) %>%
               summarise(Neuroticism=first(Neuroticism), .groups="drop")
        med <- median(pn$Neuroticism)
        hi  <- pn$id[pn$Neuroticism >= med]
        lo  <- pn$id[pn$Neuroticism <  med]
        c(sample(hi, ceiling(N/2), replace=TRUE),
          sample(lo, N-ceiling(N/2), replace=TRUE))
    } else {
        sample(unique_ids, N, replace=TRUE)
    }
}

make_boot_data <- function(b) {
    sids <- create_boot_sample(b)
    bd   <- data.frame()
    for(j in seq_along(sids)) {
        pd    <- dat %>% filter(id==sids[j])
        pd$id <- paste0("b", j)
        bd    <- rbind(bd, pd)
    }
    list(data=prepare_ctsem_data(bd), n_unique=length(unique(sids)))
}

# =============================================================================
# 第1步：原始完整样本
# =============================================================================
cat("══ 第1步：原始完整样本（finish_samples=500）══\n")
t0       <- Sys.time()
res_full <- fit_one(prepare_ctsem_data(dat), finish_samples=500, is_full=TRUE)
t_full   <- round(as.numeric(difftime(Sys.time(),t0,units="mins")),1)

if(!res_full$success) stop("原始样本拟合失败")
cat(sprintf("\n✅ 完成（%.1f分钟）\n", t_full))
cat(sprintf("   DRIFT: PP=%.4f  AA=%.4f  PA=%.4f  AP=%.4f\n\n",
            res_full$drift$drift_PP, res_full$drift$drift_AA,
            res_full$drift$drift_PA, res_full$drift$drift_AP))

# =============================================================================
# 第2步：Bootstrap
# =============================================================================
cat(sprintf("══ 预生成%d个Bootstrap数据集 ══\n", config$n_boot))
all_boot_inputs <- lapply(1:config$n_boot, make_boot_data)
cat("✅ 准备完毕\n\n")

partial_file <- file.path(config$save_path, "boot_partial.rds")
if(file.exists(partial_file)) {
    boot_results <- readRDS(partial_file)
    done    <- sum(sapply(boot_results, function(x) !is.null(x)))
    start_b <- done + 1
    cat(sprintf("📂 发现已保存进度，从第%d次续跑\n\n", start_b))
} else {
    boot_results <- vector("list", config$n_boot)
    start_b      <- 1
}

cat(sprintf("══ Bootstrap（%d次，finishsamples=%d）══\n",
            config$n_boot, config$finish_samples))
t_bs <- Sys.time()

for(b in start_b:config$n_boot) {
    cat(sprintf("[%d/%d] n_unique=%d 拟合中...",
                b, config$n_boot, all_boot_inputs[[b]]$n_unique))
    tb <- Sys.time()
    r  <- fit_one(all_boot_inputs[[b]]$data,
                  finish_samples=config$finish_samples)
    r$boot_id  <- b
    r$n_unique <- all_boot_inputs[[b]]$n_unique
    boot_results[[b]] <- r

    el <- round(as.numeric(difftime(Sys.time(),tb,units="mins")),1)
    if(r$success) {
        cat(sprintf(" ✅ %.1fmin | PP=%.4f AA=%.4f\n",
                    el, r$drift$drift_PP, r$drift$drift_AA))
    } else {
        cat(sprintf(" ❌ %.1fmin | %s\n", el, r$error))
    }

    if(b%%5==0 || b==config$n_boot) {
        saveRDS(boot_results, partial_file)
        cat(sprintf("    💾 已保存（%d/%d）\n", b, config$n_boot))
    }
}

t_total   <- round(as.numeric(difftime(Sys.time(),t_bs,units="mins")),1)
n_success <- sum(sapply(boot_results, function(r) !is.null(r) && isTRUE(r$success)))
n_fail    <- config$n_boot - n_success
cat(sprintf("\n✅ Bootstrap完成 | %.1f分钟 | 成功%d 失败%d\n\n",
            t_total, n_success, n_fail))

# =============================================================================
# 第3步：整理结果
# =============================================================================
cat("══ 整理结果 ══\n")

# DRIFT汇总
drift_df <- lapply(boot_results, function(r) {
    if(!is.null(r) && isTRUE(r$success) && !is.null(r$drift))
        cbind(data.frame(boot_id=r$boot_id, n_unique=r$n_unique), r$drift)
}) %>% bind_rows()

drift_summary <- data.frame(
    parameter = c("P_P","A_A","P_A","A_P"),
    original  = c(res_full$drift$drift_PP, res_full$drift$drift_AA,
                  res_full$drift$drift_PA, res_full$drift$drift_AP),
    stringsAsFactors=FALSE
) %>% mutate(
    boot_mean = c(mean(drift_df$drift_PP), mean(drift_df$drift_AA),
                  mean(drift_df$drift_PA), mean(drift_df$drift_AP)),
    boot_sd   = c(sd(drift_df$drift_PP),   sd(drift_df$drift_AA),
                  sd(drift_df$drift_PA),   sd(drift_df$drift_AP)),
    ci_lo95   = c(quantile(drift_df$drift_PP,.025), quantile(drift_df$drift_AA,.025),
                  quantile(drift_df$drift_PA,.025), quantile(drift_df$drift_AP,.025)),
    ci_hi95   = c(quantile(drift_df$drift_PP,.975), quantile(drift_df$drift_AA,.975),
                  quantile(drift_df$drift_PA,.975), quantile(drift_df$drift_AP,.975)),
    dir_pct   = c(mean(drift_df$drift_PP<0)*100,
                  mean(drift_df$drift_AA<0)*100,
                  mean(sign(drift_df$drift_PA)==sign(res_full$drift$drift_PA))*100,
                  mean(sign(drift_df$drift_AP)==sign(res_full$drift$drift_AP))*100),
    CV        = c(abs(sd(drift_df$drift_PP)/mean(drift_df$drift_PP)),
                  abs(sd(drift_df$drift_AA)/mean(drift_df$drift_AA)),
                  abs(sd(drift_df$drift_PA)/mean(drift_df$drift_PA)),
                  abs(sd(drift_df$drift_AP)/mean(drift_df$drift_AP)))
)

cat("\n【DRIFT参数Bootstrap汇总】\n")
cat(sprintf("%-5s  %8s  %8s  %7s  %20s  %6s  %5s\n",
            "参数","原始值","Boot均","SD","95%CI","方向%","CV"))
cat(paste(rep("─",72),collapse=""),"\n")
for(i in 1:nrow(drift_summary)) {
    r <- drift_summary[i,]
    cat(sprintf("%-5s  %8.4f  %8.4f  %7.4f  [%7.4f,%7.4f]  %5.0f%%  %.2f\n",
                r$parameter, r$original, r$boot_mean, r$boot_sd,
                r$ci_lo95, r$ci_hi95, r$dir_pct, r$CV))
}

# TIPRED汇总
tipred_df <- lapply(boot_results, function(r) {
    if(!is.null(r) && isTRUE(r$success) && !is.null(r$tipred))
        cbind(data.frame(boot_id=r$boot_id), r$tipred)
}) %>% bind_rows()

cat(sprintf("\n✅ TIPRED原始数据：%d行（预期%d×28=%d）\n",
            nrow(tipred_df), n_success, n_success*28))

# 验证无重复
if(nrow(tipred_df) > 0) {
    dup <- tipred_df %>%
        group_by(boot_id, predictor, target) %>%
        summarise(n=n(), .groups="drop") %>% filter(n>1)
    if(nrow(dup)>0) cat(sprintf("⚠️ 仍有%d个重复组合！\n", nrow(dup)))
    else            cat("✅ 无重复行确认\n")
}

tipred_summary <- NULL
if(nrow(tipred_df) > 0) {
    tipred_summary <- tipred_df %>%
        group_by(predictor, target) %>%
        summarise(
            original = {
                ov <- res_full$tipred$value[
                    res_full$tipred$predictor==first(predictor) &
                    res_full$tipred$target==first(target)]
                if(length(ov)>0) ov[1] else NA_real_
            },
            boot_mean = mean(value, na.rm=TRUE),
            boot_sd   = sd(value,   na.rm=TRUE),
            ci_lo95   = quantile(value, .025, na.rm=TRUE),
            ci_hi95   = quantile(value, .975, na.rm=TRUE),
            dir_pct   = {
                ov <- res_full$tipred$value[
                    res_full$tipred$predictor==first(predictor) &
                    res_full$tipred$target==first(target)]
                if(length(ov)>0 && !is.na(ov[1]))
                    mean(sign(value)==sign(ov[1]), na.rm=TRUE)*100
                else NA_real_
            },
            CV     = abs(sd(value,na.rm=TRUE)/mean(value,na.rm=TRUE)),
            n_boot = n(),
            .groups= "drop"
        ) %>%
        mutate(
            sig       = sign(ci_lo95) == sign(ci_hi95),
            parameter = paste0(predictor, "_->_", target),
            stability = case_when(
                dir_pct>=90 & CV<0.5 ~ "高稳定",
                dir_pct>=75 & CV<1.0 ~ "中稳定",
                TRUE                 ~ "低稳定"
            )
        )

    cat(sprintf("\n✅ TIpred汇总：%d行（预期28）\n", nrow(tipred_summary)))

    cat("\n【TI预测变量Bootstrap汇总（7×4=28行）】\n")
    for(tgt in c("P_P","A_A","P_A","A_P")) {
        cat(sprintf("\n── %s ──\n", tgt))
        sub <- tipred_summary %>% filter(target==tgt) %>%
               arrange(desc(abs(boot_mean)))
        cat(sprintf("  %-18s %8s %8s %7s %20s %5s %s\n",
                    "Predictor","原始值","Boot均","SD","95%CI","方向%","稳定性"))
        for(i in 1:nrow(sub)) {
            r <- sub[i,]
            cat(sprintf("  %-18s %8.4f %8.4f %7.4f [%7.4f,%7.4f] %4.0f%% %s%s\n",
                        r$predictor,
                        ifelse(is.na(r$original),0,r$original),
                        r$boot_mean, r$boot_sd,
                        r$ci_lo95, r$ci_hi95,
                        ifelse(is.na(r$dir_pct),0,r$dir_pct),
                        r$stability,
                        ifelse(isTRUE(r$sig)," ★","")))
        }
    }

    sig_eff <- tipred_summary %>% filter(isTRUE(sig))
    cat(sprintf("\n【★显著效应（95%%CI不含0）：%d个】\n", nrow(sig_eff)))
    if(nrow(sig_eff) > 0) {
        for(i in 1:nrow(sig_eff)) {
            r <- sig_eff[i,]
            cat(sprintf("  %s → %s  orig=%.4f  boot=%.4f  [%.4f,%.4f]  dir=%.0f%%\n",
                        r$predictor, r$target,
                        ifelse(is.na(r$original),0,r$original),
                        r$boot_mean, r$ci_lo95, r$ci_hi95, r$dir_pct))
        }
    } else {
        cat("  （无，与N=30小样本预期一致）\n")
    }
}

# =============================================================================
# 第4步：保存CSV
