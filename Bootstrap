# ── 图4：Bootstrap稳定性总览热图 ──
tryCatch({
    p4 <- tipred_boot_summary %>%
        mutate(
            predictor = recode(predictor,
                age="年龄", gender="性别",
                PC1="PC1", PC2="PC2"),
            target = recode(target,
                eta_P="η_P 正向情绪", eta_A="η_A 负向情绪"),
            dir_pct_fill = pmin(dir_pct, 100)
        ) %>%
        ggplot(aes(x=target, y=predictor, fill=dir_pct_fill)) +
        geom_tile(color="white", linewidth=1) +
        geom_text(aes(
            label=paste0(round(boot_mean,3),"\n[",round(ci_lo95,3),",",round(ci_hi95,3),"]\n",
                         ifelse(sig,"*","")),
            color=dir_pct_fill>60), size=3.2, lineheight=1.1) +
        scale_fill_gradient2(
            low="#3498DB", mid="white", high="#E74C3C",
            midpoint=50, limits=c(0,100),
            name="方向一致性(%)") +
        scale_color_manual(values=c("TRUE"="black","FALSE"="white"), guide="none") +
        labs(
            title    = "Bootstrap Stability Heatmap",
            subtitle = "Cell: Boot mean [95% CI]; * = significant (CI excludes 0)",
            x="", y=""
        ) +
        theme_bw(base_size=13) +
        theme(
            plot.title      = element_text(hjust=.5, face="bold"),
            plot.subtitle   = element_text(hjust=.5, color="gray40"),
            axis.text       = element_text(face="bold"),
            legend.position = "right"
        )

    ggsave(file.path(config$save_path,"plots","Fig4_Stability_Heatmap.png"),
           p4, width=10, height=6, dpi=300)
    cat("  ✅ Fig4_Stability_Heatmap.png\n")
}, error=function(e) cat("  ❌ 热图:", e$message,"\n"))

# =============================================================================
# 最终摘要
# =============================================================================
cat("\n╔══════════════════════════════════════════════════╗\n")
cat("║              分析完成 ── 结果摘要                ║\n")
cat("╠══════════════════════════════════════════════════╣\n")
cat(sprintf("║  Bootstrap次数   : %d 次（成功%d / 失败%d）%s\n",
            config$n_boot, n_success, n_fail,
            paste(rep(" ",max(0,14-nchar(sprintf("%d/%d",n_success,n_fail)))),collapse="")))
cat(sprintf("║  Bootstrap耗时   : %.1f 分钟\n", t_boot_total))
cat(sprintf("║  显著DRIFT参数   : %d / %d\n",
            sum(drift_boot_summary$sig), nrow(drift_boot_summary)))
cat(sprintf("║  显著TI效应      : %d / %d\n",
            sum(tipred_boot_summary$sig), nrow(tipred_boot_summary)))
cat("╠══════════════════════════════════════════════════╣\n")
cat("║  输出文件：                                      ║\n")
cat("║  Table1_DRIFT_Bootstrap.csv   ← 论文Table 1     ║\n")
cat("║  Table2_TIpred_Bootstrap.csv  ← 论文Table 2     ║\n")
cat("║  Fig1_TIpred_ForestPlot.png   ← 论文Figure 1    ║\n")
cat("║  Fig2_DRIFT_Bootstrap.png     ← 论文Figure 2    ║\n")
cat("║  Fig3_PCA_Loadings.png        ← 论文Figure 3    ║\n")
cat("║  Fig4_Stability_Heatmap.png   ← 论文Figure 4    ║\n")
cat(sprintf("║  保存路径: %-38s║\n", config$save_path))
cat("╚══════════════════════════════════════════════════╝\n")
cat("🎉 全部完成！\n")
