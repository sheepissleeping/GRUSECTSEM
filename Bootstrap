# =============================================================================
# Bootstrap鲁棒性分析（含TI预测变量）
# =============================================================================
#
# 审稿人质疑：
#   "新增的鲁棒性检查主要验证了省略时不变预测变量的简化模型中
#    核心DRIFT参数的稳定性，这并未为调节主张提供有意义的验证"
#
# 之前的Bootstrap：只拟合DRIFT主效应（无TI预测变量）
# 本代码：Bootstrap时包含全部7个TI预测变量，验证：
#   1. DRIFT参数（P_P, A_A, P_A, A_P）的稳定性
#   2. TI预测变量效应的方向一致性（sign consistency）
#   3. TI预测变量效应的置信区间覆盖
#
# 方法：
#   有放回抽样30个个体（个体级Bootstrap），保留每个个体的全部时间序列
#   重复n_boot次，每次拟合完整CTSEM（含TI预测变量）
# =============================================================================

cat("\n")
cat("═══════════════════════════════════════════════════════════════════\n")
cat("  Bootstrap鲁棒性分析（含TI预测变量）\n")
cat("═══════════════════════════════════════════════════════════════════\n\n")

suppressPackageStartupMessages({
  library(readxl)
  library(dplyr)
  library(tidyr)
  library(ggplot2)
  library(ctsem)
  library(zoo)
})

# =============================================================================
# 配置
# =============================================================================
config <- list(
  data_path = "D:/data.xlsx",
  save_path = "C:/Users/48538/Desktop/sanxiu/bootstrap_tipred",
  n_boot = 50,           # Bootstrap重复次数
  base_seed = 2025,
  smooth_window = 3       # 3点移动平均（与原始分析一致）
)

if(!dir.exists(config$save_path)) dir.create(config$save_path, recursive = TRUE)
if(!dir.exists(file.path(config$save_path, "plots"))) {
  dir.create(file.path(config$save_path, "plots"))
}

# =============================================================================
# 加载和准备数据
# =============================================================================
cat("加载数据...\n")

emotion_labels <- c("hap", "sad", "neu", "ang", "sur", "dis", "fea")

dat_raw <- read_excel(config$data_path)
dat_raw <- dat_raw %>%
  rename(
    id = name,
    time = start_second,
    emotion_label = label,
    Neuroticism = Negative_Emotionality,
    Openness = Open_Mindedness
  ) %>%
  mutate(
    id = as.character(id),
    time = as.numeric(time)
  ) %>%
  filter(complete.cases(P, A, id, time))

# 3点移动平均
dat <- dat_raw %>%
  group_by(id) %>%
  arrange(time) %>%
  mutate(
    P_smooth = zoo::rollmean(P, k = config$smooth_window, fill = "extend"),
    A_smooth = zoo::rollmean(A, k = config$smooth_window, fill = "extend")
  ) %>%
  ungroup()

unique_ids <- unique(dat$id)
N <- length(unique_ids)

cat(sprintf("✅ %d观测, %d个体, 每人约%d时间点\n\n",
            nrow(dat), N, round(nrow(dat)/N)))

# 固定标准化参数（基于完整样本，所有Bootstrap迭代使用相同基准）
std_params <- list(
  P_mean = mean(dat$P_smooth), P_sd = sd(dat$P_smooth),
  A_mean = mean(dat$A_smooth), A_sd = sd(dat$A_smooth),
  age_mean = mean(dat$age), age_sd = sd(dat$age),
  gender_mean = mean(dat$gender),
  E_mean = mean(dat$Extraversion), E_sd = sd(dat$Extraversion),
  Agr_mean = mean(dat$Agreeableness), Agr_sd = sd(dat$Agreeableness),
  Con_mean = mean(dat$Conscientiousness), Con_sd = sd(dat$Conscientiousness),
  Neu_mean = mean(dat$Neuroticism), Neu_sd = sd(dat$Neuroticism),
  Ope_mean = mean(dat$Openness), Ope_sd = sd(dat$Openness)
)

# =============================================================================
# 辅助函数
# =============================================================================
prepare_ctsem_data <- function(dat_sub, std_params) {
  dat_sub %>%
    mutate(
      P = (P_smooth - std_params$P_mean) / std_params$P_sd,
      A = (A_smooth - std_params$A_mean) / std_params$A_sd,
      age = (age - std_params$age_mean) / std_params$age_sd,
      gender = gender - std_params$gender_mean,
      Extraversion = (Extraversion - std_params$E_mean) / std_params$E_sd,
      Agreeableness = (Agreeableness - std_params$Agr_mean) / std_params$Agr_sd,
      Conscientiousness = (Conscientiousness - std_params$Con_mean) / std_params$Con_sd,
      Neuroticism = (Neuroticism - std_params$Neu_mean) / std_params$Neu_sd,
      Openness = (Openness - std_params$Ope_mean) / std_params$Ope_sd
    ) %>%
    select(id, time, P, A, age, gender, Extraversion, Agreeableness,
           Conscientiousness, Neuroticism, Openness) %>%
    as.data.frame()
}

ti_covs <- c("age", "gender", "Extraversion", "Agreeableness",
             "Conscientiousness", "Neuroticism", "Openness")

fit_one <- function(model_data, label) {
  tryCatch({
    mod <- ctModel(
      type = 'stanct',
      n.latent = 2, n.manifest = 2,
      LAMBDA = diag(2),
      manifestNames = c('P', 'A'),
      latentNames = c('eta_P', 'eta_A'),
      TIpredNames = ti_covs,
      id = 'id', time = 'time'
    )
    
    fit <- ctStanFit(
      datalong = model_data,
      ctstanmodel = mod,
      optimize = TRUE,
      optimcontrol = list(stochastic = FALSE, finishsamples = 1000),
      cores = 1, nopriors = TRUE, verbose = 0
    )
    
    s <- summary(fit)
    
    # DRIFT
    drift <- as.data.frame(s$parmatrices) %>% filter(matrix == "DRIFT")
    drift_result <- data.frame(
      drift_PP = drift$Mean[drift$row == 1 & drift$col == 1],
      drift_AA = drift$Mean[drift$row == 2 & drift$col == 2],
      drift_PA = drift$Mean[drift$row == 2 & drift$col == 1],
      drift_AP = drift$Mean[drift$row == 1 & drift$col == 2]
    )
    
    # TI预测变量
    tipred_result <- NULL
    if(!is.null(s$tipreds)) {
      tp <- as.data.frame(s$tipreds)
      tp$parameter <- rownames(tp)
      if("Mean" %in% names(tp)) tp$mean <- tp$Mean
      tipred_result <- tp
    }
    
    list(drift = drift_result, tipred = tipred_result, success = TRUE)
    
  }, error = function(e) {
    list(drift = NULL, tipred = NULL, success = FALSE, error = e$message)
  })
}

# =============================================================================
# 第1步：拟合原始完整样本（参考值）
# =============================================================================
cat("═══════════════════════════════════════════════════════════════════\n")
cat("  第1步：拟合原始完整样本\n")
cat("═══════════════════════════════════════════════════════════════════\n\n")

model_data_full <- prepare_ctsem_data(dat, std_params)
cat("  拟合中...\n")
t0 <- Sys.time()
res_full <- fit_one(model_data_full, "full_sample")
t_full <- as.numeric(difftime(Sys.time(), t0, units = "mins"))

if(res_full$success) {
  cat(sprintf("  ✅ 完成 (%.1f分钟)\n", t_full))
  cat(sprintf("  DRIFT: P→P=%.4f, A→A=%.4f, P→A=%.4f, A→P=%.4f\n\n",
              res_full$drift$drift_PP, res_full$drift$drift_AA,
              res_full$drift$drift_PA, res_full$drift$drift_AP))
  
  # 打印TI预测变量
  if(!is.null(res_full$tipred)) {
    key_tip <- res_full$tipred %>%
      filter(grepl("_drift_", parameter))
    cat("  TI预测变量效应（drift相关）：\n")
    for(i in 1:nrow(key_tip)) {
      cat(sprintf("    %s: %.4f\n", key_tip$parameter[i], key_tip$mean[i]))
    }
    cat("\n")
  }
} else {
  cat("  ❌ 原始样本拟合失败:", res_full$error, "\n")
  stop("原始样本必须成功拟合")
}

# =============================================================================
# 第2步：Bootstrap循环
# =============================================================================
cat("═══════════════════════════════════════════════════════════════════\n")
cat(sprintf("  第2步：Bootstrap (%d次, 有放回抽样%d个体)\n", config$n_boot, N))
cat(sprintf("  预计耗时: %.0f-%.0f分钟\n", 
            config$n_boot * t_full * 0.8, config$n_boot * t_full * 1.2))
cat("═══════════════════════════════════════════════════════════════════\n\n")

boot_drift <- list()
boot_tipred <- list()
n_success <- 0
n_fail <- 0

for(b in 1:config$n_boot) {
  set.seed(config$base_seed + b)
  
  # 有放回抽样个体
  sampled_ids <- sample(unique_ids, N, replace = TRUE)
  
  # 构建Bootstrap数据集（重复的个体需要新ID避免冲突）
  boot_data <- data.frame()
  for(j in 1:N) {
    person_data <- dat %>% filter(id == sampled_ids[j])
    person_data$id <- paste0("boot_", j)  # 给每个位置新ID
    boot_data <- rbind(boot_data, person_data)
  }
  
  # 统计唯一个体数（有放回所以可能有重复）
  n_unique <- length(unique(sampled_ids))
  
  cat(sprintf("[%d/%d] 抽样%d个独特个体... ", b, config$n_boot, n_unique))
  
  model_data_boot <- prepare_ctsem_data(boot_data, std_params)
  res <- fit_one(model_data_boot, sprintf("boot_%d", b))
  
  if(res$success) {
    n_success <- n_success + 1
    
    drift_row <- res$drift
    drift_row$boot_id <- b
    drift_row$n_unique <- n_unique
    boot_drift[[n_success]] <- drift_row
    
    if(!is.null(res$tipred)) {
      tp <- res$tipred
      tp$boot_id <- b
      boot_tipred[[length(boot_tipred) + 1]] <- tp
    }
    
    cat(sprintf("✅ PP=%.4f AA=%.4f\n",
                drift_row$drift_PP, drift_row$drift_AA))
  } else {
    n_fail <- n_fail + 1
    cat(sprintf("❌ %s\n", res$error))
  }
}

cat(sprintf("\n完成: %d成功, %d失败\n\n", n_success, n_fail))

# =============================================================================
# 第3步：整理结果
# =============================================================================
cat("═══════════════════════════════════════════════════════════════════\n")
cat("  整理Bootstrap结果\n")
cat("═══════════════════════════════════════════════════════════════════\n\n")

# --- DRIFT结果 ---
drift_df <- bind_rows(boot_drift)

drift_summary <- data.frame(
  parameter = c("P_P", "A_A", "P_A", "A_P"),
  original = c(res_full$drift$drift_PP, res_full$drift$drift_AA,
               res_full$drift$drift_PA, res_full$drift$drift_AP),
  boot_mean = c(mean(drift_df$drift_PP), mean(drift_df$drift_AA),
                mean(drift_df$drift_PA), mean(drift_df$drift_AP)),
  boot_sd = c(sd(drift_df$drift_PP), sd(drift_df$drift_AA),
              sd(drift_df$drift_PA), sd(drift_df$drift_AP)),
  boot_ci_lower = c(quantile(drift_df$drift_PP, 0.025),
                     quantile(drift_df$drift_AA, 0.025),
                     quantile(drift_df$drift_PA, 0.025),
                     quantile(drift_df$drift_AP, 0.025)),
  boot_ci_upper = c(quantile(drift_df$drift_PP, 0.975),
                     quantile(drift_df$drift_AA, 0.975),
                     quantile(drift_df$drift_PA, 0.975),
                     quantile(drift_df$drift_AP, 0.975)),
  stringsAsFactors = FALSE
)

# CV和方向一致性
drift_summary$CV <- abs(drift_summary$boot_sd / drift_summary$boot_mean)
drift_summary$direction_consistency <- c(
  mean(drift_df$drift_PP < 0) * 100,
  mean(drift_df$drift_AA < 0) * 100,
  mean(sign(drift_df$drift_PA) == sign(res_full$drift$drift_PA)) * 100,
  mean(sign(drift_df$drift_AP) == sign(res_full$drift$drift_AP)) * 100
)

cat("DRIFT参数Bootstrap汇总：\n")
cat(sprintf("%-6s  原始值      Boot均值    Boot SD     95%%CI                CV      方向一致性\n", "参数"))
cat(paste(rep("-", 90), collapse=""), "\n")
for(i in 1:nrow(drift_summary)) {
  row <- drift_summary[i,]
  cat(sprintf("%-6s  %8.4f    %8.4f    %8.4f    [%7.4f, %7.4f]   %.2f    %.0f%%\n",
              row$parameter, row$original, row$boot_mean, row$boot_sd,
              row$boot_ci_lower, row$boot_ci_upper, row$CV,
              row$direction_consistency))
}
cat("\n")

write.csv(drift_df, file.path(config$save_path, "bootstrap_DRIFT_all.csv"), row.names = FALSE)
write.csv(drift_summary, file.path(config$save_path, "bootstrap_DRIFT_summary.csv"), row.names = FALSE)

# --- TI预测变量结果 ---
if(length(boot_tipred) > 0) {
  tipred_df <- bind_rows(boot_tipred)
  
  # 提取drift相关的TI预测变量效应
  tipred_drift <- tipred_df %>%
    filter(grepl("_drift_", parameter)) %>%
    group_by(parameter) %>%
    summarise(
      boot_mean = mean(mean, na.rm = TRUE),
      boot_sd = sd(mean, na.rm = TRUE),
      boot_ci_lower = quantile(mean, 0.025, na.rm = TRUE),
      boot_ci_upper = quantile(mean, 0.975, na.rm = TRUE),
      n_boot = n(),
      .groups = "drop"
    )
  
  # 添加原始值
  if(!is.null(res_full$tipred)) {
    orig_tip <- res_full$tipred %>%
      filter(grepl("_drift_", parameter)) %>%
      select(parameter, mean)
    names(orig_tip)[2] <- "original"
    tipred_drift <- left_join(tipred_drift, orig_tip, by = "parameter")
  }
  
  # 方向一致性
  tipred_direction <- tipred_df %>%
    filter(grepl("_drift_", parameter)) %>%
    group_by(parameter) %>%
    summarise(
      direction_consistency = {
        orig_val <- res_full$tipred$mean[res_full$tipred$parameter == first(parameter)]
        if(length(orig_val) > 0 && !is.na(orig_val)) {
          mean(sign(mean) == sign(orig_val), na.rm = TRUE) * 100
        } else {
          NA
        }
      },
      .groups = "drop"
    )
  
  tipred_drift <- left_join(tipred_drift, tipred_direction, by = "parameter")
  tipred_drift$CV <- abs(tipred_drift$boot_sd / tipred_drift$boot_mean)
  
  # 提取预测变量名和目标参数
  tipred_drift <- tipred_drift %>%
    mutate(
      predictor = gsub("tip_(.+)_drift_.*", "\\1", parameter),
      target = case_when(
        grepl("eta_P$", parameter) ~ "P_P",
        grepl("eta_A$", parameter) ~ "A_A",
        grepl("eta_P_eta_A$", parameter) ~ "P_A",
        grepl("eta_A_eta_P$", parameter) ~ "A_P",
        TRUE ~ "other"
      )
    )
  
  cat("\nTI预测变量Bootstrap汇总（drift效应）：\n")
  cat(sprintf("%-40s  原始值    Boot均值  Boot SD   95%%CI                  方向一致性\n", "参数"))
  cat(paste(rep("-", 110), collapse=""), "\n")
  for(i in 1:nrow(tipred_drift)) {
    row <- tipred_drift[i,]
    orig <- ifelse(is.na(row$original), NA, row$original)
    cat(sprintf("%-40s  %7.4f   %7.4f   %7.4f   [%7.4f, %7.4f]   %.0f%%\n",
                row$parameter,
                ifelse(is.na(orig), 0, orig),
                row$boot_mean, row$boot_sd,
                row$boot_ci_lower, row$boot_ci_upper,
                ifelse(is.na(row$direction_consistency), 0, row$direction_consistency)))
  }
  cat("\n")
  
  write.csv(tipred_df, file.path(config$save_path, "bootstrap_TIpred_all.csv"), row.names = FALSE)
  write.csv(tipred_drift, file.path(config$save_path, "bootstrap_TIpred_summary.csv"), row.names = FALSE)
  cat("✅ TI预测变量结果已保存\n")
}

# =============================================================================
# 第4步：可视化
# =============================================================================
cat("\n═══ 生成可视化 ═══\n\n")

# 图1：DRIFT参数Bootstrap分布
cat("[1/2] DRIFT分布图...\n")
tryCatch({
  drift_long <- drift_df %>%
    select(boot_id, drift_PP, drift_AA, drift_PA, drift_AP) %>%
    pivot_longer(cols = -boot_id, names_to = "param", values_to = "value") %>%
    mutate(param = case_when(
      param == "drift_PP" ~ "P → P",
      param == "drift_AA" ~ "A → A",
      param == "drift_PA" ~ "P → A",
      param == "drift_AP" ~ "A → P"
    ))
  
  ref_lines <- data.frame(
    param = c("P → P", "A → A", "P → A", "A → P"),
    ref = c(res_full$drift$drift_PP, res_full$drift$drift_AA,
            res_full$drift$drift_PA, res_full$drift$drift_AP)
  )
  
  p1 <- ggplot(drift_long, aes(x = value)) +
    geom_histogram(fill = "#3C5488", alpha = 0.7, bins = 20) +
    geom_vline(data = ref_lines, aes(xintercept = ref),
               color = "red", linetype = "dashed", linewidth = 1) +
    facet_wrap(~param, scales = "free", ncol = 2) +
    labs(
      title = sprintf("Bootstrap Distribution of DRIFT Parameters (n = %d)", n_success),
      subtitle = "Red dashed line = original full-sample estimate",
      x = "Parameter Estimate", y = "Count"
    ) +
    theme_minimal(base_size = 13) +
    theme(plot.title = element_text(hjust = 0.5, face = "bold"),
          plot.subtitle = element_text(hjust = 0.5, color = "gray40"),
          strip.text = element_text(face = "bold", size = 13))
  
  ggsave(file.path(config$save_path, "plots", "01_bootstrap_DRIFT_dist.png"),
         p1, width = 12, height = 8, dpi = 300)
  cat("  ✅\n")
}, error = function(e) cat("  ❌", e$message, "\n"))

# 图2：TI预测变量Bootstrap方向一致性
if(exists("tipred_drift")) {
  cat("[2/2] TI预测变量方向一致性图...\n")
  tryCatch({
    # 只画autoregression的TI效应（最重要的）
    tipred_plot <- tipred_drift %>%
      filter(target %in% c("P_P", "A_A")) %>%
      mutate(
        label = sprintf("%s → %s", predictor, target),
        sig_color = ifelse(!is.na(direction_consistency) & direction_consistency >= 80,
                           "Consistent (≥80%)", "Inconsistent (<80%)")
      )
    
    p2 <- ggplot(tipred_plot, aes(x = reorder(label, direction_consistency),
                                    y = direction_consistency, fill = sig_color)) +
      geom_col(alpha = 0.8) +
      geom_hline(yintercept = 80, linetype = "dashed", color = "red") +
      coord_flip() +
      scale_fill_manual(values = c("Consistent (≥80%)" = "#00A087",
                                    "Inconsistent (<80%)" = "#E64B35")) +
      labs(
        title = "Bootstrap Direction Consistency of TI Predictor Effects",
        subtitle = sprintf("n = %d bootstrap samples | Red line = 80%% threshold", n_success),
        x = "", y = "Direction Consistency (%)", fill = ""
      ) +
      theme_minimal(base_size = 13) +
      theme(plot.title = element_text(hjust = 0.5, face = "bold"),
            plot.subtitle = element_text(hjust = 0.5, color = "gray40"),
            legend.position = "bottom")
    
    ggsave(file.path(config$save_path, "plots", "02_bootstrap_TIpred_consistency.png"),
           p2, width = 12, height = 8, dpi = 300)
    cat("  ✅\n")
  }, error = function(e) cat("  ❌", e$message, "\n"))
}

# =============================================================================
# 第5步：生成报告
# =============================================================================
report_file <- file.path(config$save_path, "bootstrap_tipred_report.txt")
sink(report_file)

cat("═══════════════════════════════════════════════════════════════════\n")
cat("  Bootstrap Analysis Report (with TI Predictors)\n")
cat("═══════════════════════════════════════════════════════════════════\n\n")
cat("Date:", format(Sys.time(), "%Y-%m-%d"), "\n")
cat(sprintf("Bootstrap iterations: %d (success: %d, fail: %d)\n", config$n_boot, n_success, n_fail))
cat(sprintf("Method: Person-level resampling with replacement (N=%d)\n\n", N))

cat("1. DRIFT Parameters\n")
cat("────────────────────\n")
for(i in 1:nrow(drift_summary)) {
  row <- drift_summary[i,]
  cat(sprintf("  %s: original=%.4f, boot=%.4f±%.4f, 95%%CI=[%.4f,%.4f], CV=%.2f, dir=%.0f%%\n",
              row$parameter, row$original, row$boot_mean, row$boot_sd,
              row$boot_ci_lower, row$boot_ci_upper, row$CV, row$direction_consistency))
}

if(exists("tipred_drift")) {
  cat("\n2. TI Predictor Effects on Autoregression (P_P, A_A)\n")
  cat("─────────────────────────────────────────────────────\n")
  for(i in 1:nrow(tipred_drift)) {
    row <- tipred_drift[i,]
    if(row$target %in% c("P_P", "A_A")) {
      cat(sprintf("  %s → %s: boot=%.4f±%.4f, dir=%.0f%%\n",
                  row$predictor, row$target, row$boot_mean, row$boot_sd,
                  ifelse(is.na(row$direction_consistency), 0, row$direction_consistency)))
    }
  }
  
  cat("\n3. TI Predictor Effects on Cross-Effects (P_A, A_P)\n")
  cat("─────────────────────────────────────────────────────\n")
  for(i in 1:nrow(tipred_drift)) {
    row <- tipred_drift[i,]
    if(row$target %in% c("P_A", "A_P")) {
      cat(sprintf("  %s → %s: boot=%.4f±%.4f, dir=%.0f%%\n",
                  row$predictor, row$target, row$boot_mean, row$boot_sd,
                  ifelse(is.na(row$direction_consistency), 0, row$direction_consistency)))
    }
  }
}

cat("\n═══════════════════════════════════════════════════════════════════\n")
sink()
cat("\n✅ 报告已保存:", report_file, "\n")

# =============================================================================
# 完成
# =============================================================================
cat("\n═══════════════════════════════════════════════════════════════════\n")
cat(sprintf("  🎉 Bootstrap完成！%d次成功拟合\n", n_success))
cat(sprintf("  预计每次拟合%.1f分钟, 总耗时约%.0f分钟\n", t_full, n_success * t_full))
cat("  保存位置：", config$save_path, "\n")
cat("═══════════════════════════════════════════════════════════════════\n\n")

