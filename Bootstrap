    ggsave(file.path(config$save_path,"plots","Fig2_DRIFT_Bootstrap.png"),
           p2, width=12, height=8, dpi=300)
    cat("  ✅ Fig2_DRIFT_Bootstrap.png\n")
}, error=function(e) cat("  ❌ Drift图:", e$message,"\n"))

# ── 图3：PCA载荷图 ──
tryCatch({
