
suppressPackageStartupMessages({
    library(readxl); library(dplyr); library(tidyr)
    library(ggplot2); library(ctsem); library(zoo)
    library(foreach); library(doParallel)
})
config <- list(
    data_path      = "C:/Users/22825/Desktop/data.xlsx",
    save_path      = "C:/Users/22825/Desktop/sanxiu",
    n_boot         = 50,
    base_seed      = 2025,
    smooth_window  = 3,
    n_pca_comp     = 2,
    finish_samples = 300,   # Bootstrap用300（快）；原始样本用1000（精）
    n_workers      = 4      # 8核机器用4，安全稳定
)

USE_PCA        <- TRUE
USE_STRATIFIED <- TRUE

dir.create(config$save_path, recursive=TRUE, showWarnings=FALSE)
dir.create(file.path(config$save_path,"plots"), showWarnings=FALSE)

# =============================================================================
# 数据加载
# =============================================================================
cat("══ 加载数据 ══\n")
dat_raw <- read_excel(config$data_path) %>%
    rename(id=name, time=start_second,
           Neuroticism=Negative_Emotionality, Openness=Open_Mindedness) %>%
    mutate(id=as.character(id), time=as.numeric(time)) %>%
    filter(complete.cases(P, A, id, time))

dat <- dat_raw %>%
    group_by(id) %>% arrange(time) %>%
    mutate(
        P_smooth = zoo::rollmean(P, k=config$smooth_window, fill="extend"),
        A_smooth = zoo::rollmean(A, k=config$smooth_window, fill="extend")
    ) %>% ungroup()

unique_ids <- unique(dat$id)
N          <- length(unique_ids)
cat(sprintf("✅ %d观测, %d个体\n\n", nrow(dat), N))

# PCA降维
BIG5_COLS <- c("Extraversion","Agreeableness","Conscientiousness","Neuroticism","Openness")

cat("══ PCA降维 ══\n")
person_big5 <- dat %>%
    group_by(id) %>%
    summarise(across(all_of(BIG5_COLS), first), .groups="drop")
big5_mat <- as.matrix(person_big5[, BIG5_COLS])
pca_fit  <- prcomp(big5_mat, center=TRUE, scale.=TRUE)
var_exp  <- summary(pca_fit)$importance

cat(sprintf("  保留%d个主成分：\n", config$n_pca_comp))
for(k in 1:config$n_pca_comp)
    cat(sprintf("    PC%d: %.1f%% (累计%.1f%%)\n", k,
                var_exp["Proportion of Variance",k]*100,
                var_exp["Cumulative Proportion",k]*100))
cat("  载荷矩阵：\n")
print(round(pca_fit$rotation[,1:config$n_pca_comp], 3))

pc_scores <- predict(pca_fit, newdata=big5_mat)[,1:config$n_pca_comp,drop=FALSE]
pc_df <- as.data.frame(pc_scores)
names(pc_df) <- paste0("PC", 1:config$n_pca_comp)
pc_df$id <- person_big5$id
dat <- left_join(dat, pc_df, by="id")

TI_COVS <- c("age","gender", paste0("PC",1:config$n_pca_comp))
cat(sprintf("\n📌 TI预测变量（%d个）: %s\n\n", length(TI_COVS), paste(TI_COVS,collapse=", ")))

# 固定标准化参数（全局一次，Bootstrap不重算）
std_params <- list(
    P_mean=mean(dat$P_smooth), P_sd=sd(dat$P_smooth),
    A_mean=mean(dat$A_smooth), A_sd=sd(dat$A_smooth),
    age_mean=mean(dat$age),    age_sd=sd(dat$age),
    gender_mean=mean(dat$gender)
)
for(k in 1:config$n_pca_comp) {
    col <- paste0("PC",k)
    std_params[[paste0(col,"_mean")]] <- mean(dat[[col]])
    std_params[[paste0(col,"_sd")]]   <- sd(dat[[col]])
}

# =============================================================================
# 工具函数
# =============================================================================
prepare_ctsem_data <- function(dat_sub) {
    d <- dat_sub %>% mutate(
        P      = (P_smooth - std_params$P_mean)   / std_params$P_sd,
        A      = (A_smooth - std_params$A_mean)   / std_params$A_sd,
        age    = (age      - std_params$age_mean)  / std_params$age_sd,
        gender = gender - std_params$gender_mean
    )
    for(k in 1:config$n_pca_comp) {
        col <- paste0("PC",k)
        d[[col]] <- (dat_sub[[col]] - std_params[[paste0(col,"_mean")]]) /
                     std_params[[paste0(col,"_sd")]]
    }
    d %>% select(id, time, P, A, all_of(TI_COVS)) %>% as.data.frame()
}

# 从parmatrices精准提取TIPREDEFFECT（无重复）
extract_tipred <- function(s, ti_covs) {
    pm <- tryCatch(as.data.frame(s$parmatrices), error=function(e) NULL)
    if(is.null(pm)) return(NULL)
    tp <- pm %>% filter(matrix=="TIPREDEFFECT")
    if(nrow(tp)==0) return(NULL)
    tp %>% mutate(
        predictor = ti_covs[row],
        target    = case_when(col==1~"eta_P", col==2~"eta_A", TRUE~paste0("eta_",col)),
        parameter = paste0(predictor,"_->_",target)
    ) %>% select(parameter, predictor, target, mean=Mean)
}

fit_one <- function(model_data, ti_covs, finish_samples=300) {
    tryCatch({
        mod <- ctModel(
            type='stanct', n.latent=2, n.manifest=2, LAMBDA=diag(2),
            manifestNames=c('P','A'), latentNames=c('eta_P','eta_A'),
            TIpredNames=ti_covs, id='id', time='time'
        )
        fit <- ctStanFit(
            datalong     = model_data,
            ctstanmodel  = mod,
            optimize     = TRUE,
            optimcontrol = list(stochastic=FALSE, finishsamples=finish_samples),
            cores=1, nopriors=TRUE, verbose=0
        )
        s  <- summary(fit)
        pm <- as.data.frame(s$parmatrices)
        drift_pm <- pm %>% filter(matrix=="DRIFT")
        list(
            drift = data.frame(
                drift_PP = drift_pm$Mean[drift_pm$row==1 & drift_pm$col==1],
                drift_AA = drift_pm$Mean[drift_pm$row==2 & drift_pm$col==2],
                drift_PA = drift_pm$Mean[drift_pm$row==2 & drift_pm$col==1],
                drift_AP = drift_pm$Mean[drift_pm$row==1 & drift_pm$col==2]
            ),
            tipred  = extract_tipred(s, ti_covs),
            success = TRUE
        )
    }, error=function(e) list(drift=NULL, tipred=NULL, success=FALSE, error=e$message))
}

# =============================================================================
# 第1步：原始完整样本（高精度，finishsamples=1000）
# =============================================================================
cat("══ 拟合原始完整样本（finishsamples=1000）══\n")
t0       <- Sys.time()
res_full <- fit_one(prepare_ctsem_data(dat), TI_COVS, finish_samples=1000)
t_full   <- round(as.numeric(difftime(Sys.time(), t0, units="mins")),1)

if(!res_full$success) stop("原始样本拟合失败：", res_full$error)
cat(sprintf("✅ %.1f分钟 | PP=%.4f  AA=%.4f  PA=%.4f  AP=%.4f\n\n",
            t_full,
            res_full$drift$drift_PP, res_full$drift$drift_AA,
            res_full$drift$drift_PA, res_full$drift$drift_AP))

# =============================================================================
# 第2步：预生成所有Bootstrap数据集（主进程，避免worker数据竞争）
# =============================================================================
cat(sprintf("══ 预生成Bootstrap数据集（%d个）══\n", config$n_boot))

make_boot_data <- function(b) {
    set.seed(config$base_seed + b)
    person_neu <- dat %>% group_by(id) %>%
        summarise(Neuroticism=first(Neuroticism), .groups="drop")
    med <- median(person_neu$Neuroticism)
    hi  <- person_neu$id[person_neu$Neuroticism >= med]
    lo  <- person_neu$id[person_neu$Neuroticism <  med]
    sampled <- c(sample(hi, ceiling(N/2), replace=TRUE),
                 sample(lo, N-ceiling(N/2), replace=TRUE))
    boot_data <- data.frame()
    for(j in seq_along(sampled)) {
        pd <- dat %>% filter(id==sampled[j]); pd$id <- paste0("b",j)
        boot_data <- rbind(boot_data, pd)
    }
    list(data=prepare_ctsem_data(boot_data),
         n_unique=length(unique(sampled)))
}

all_boot_inputs <- lapply(1:config$n_boot, make_boot_data)
cat(sprintf("✅ %d个数据集准备完毕\n\n", config$n_boot))

# =============================================================================
# 第3步：并行Bootstrap（4 workers，安全稳定）
# =============================================================================
cat(sprintf("══ 并行Bootstrap（%d次，%d workers，finishsamples=%d）══\n",
            config$n_boot, config$n_workers, config$finish_samples))

cl <- makeCluster(config$n_workers)
registerDoParallel(cl)

clusterExport(cl,
    varlist = c("fit_one","extract_tipred","TI_COVS","std_params","config"),
    envir   = environment())
clusterEvalQ(cl, suppressPackageStartupMessages({
    library(ctsem); library(dplyr)
}))

t_boot <- Sys.time()
boot_results <- foreach(
    b     = 1:config$n_boot,
    input = all_boot_inputs,
    .packages      = c("ctsem","dplyr"),
    .errorhandling = "pass"
) %dopar% {
    res <- fit_one(input$data, TI_COVS, finish_samples=config$finish_samples)
    res$boot_id  <- b
    res$n_unique <- input$n_unique
    res
}

stopCluster(cl)
t_boot_total <- round(as.numeric(difftime(Sys.time(), t_boot, units="mins")),1)

n_success <- sum(sapply(boot_results, function(r) !is.null(r) && isTRUE(r$success)))
n_fail    <- config$n_boot - n_success
cat(sprintf("✅ 并行完成：%.1f分钟 | 成功%d / 失败%d\n\n", t_boot_total, n_success, n_fail))

# 保存原始Bootstrap结果
saveRDS(boot_results, file.path(config$save_path,"boot_results_raw.rds"))

# =============================================================================
# 第4步：整理真Bootstrap CI
# =============================================================================
cat("══ 整理Bootstrap CI ══\n")

# ── Drift ──
drift_df <- lapply(boot_results, function(r) {
    if(!is.null(r) && isTRUE(r$success) && !is.null(r$drift))
        cbind(data.frame(boot_id=r$boot_id), r$drift)
}) %>% bind_rows()

# ── TIPRED ──
tipred_df <- lapply(boot_results, function(r) {
    if(!is.null(r) && isTRUE(r$success) && !is.null(r$tipred))
        cbind(data.frame(boot_id=r$boot_id), r$tipred)
}) %>% bind_rows()

cat(sprintf("  Drift行数: %d | TIPRED行数: %d\n", nrow(drift_df), nrow(tipred_df)))

# ── Drift Bootstrap汇总 ──
drift_boot_summary <- data.frame(
    parameter = c("P→P(自回归)","A→A(自回归)","P→A(交叉)","A→P(交叉)"),
    original  = c(res_full$drift$drift_PP, res_full$drift$drift_AA,
                  res_full$drift$drift_PA, res_full$drift$drift_AP),
    boot_mean = c(mean(drift_df$drift_PP), mean(drift_df$drift_AA),
                  mean(drift_df$drift_PA), mean(drift_df$drift_AP)),
    boot_sd   = c(sd(drift_df$drift_PP),   sd(drift_df$drift_AA),
                  sd(drift_df$drift_PA),   sd(drift_df$drift_AP)),
    ci_lo95   = c(quantile(drift_df$drift_PP,.025), quantile(drift_df$drift_AA,.025),
                  quantile(drift_df$drift_PA,.025), quantile(drift_df$drift_AP,.025)),
    ci_hi95   = c(quantile(drift_df$drift_PP,.975), quantile(drift_df$drift_AA,.975),
                  quantile(drift_df$drift_PA,.975), quantile(drift_df$drift_AP,.975))
) %>% mutate(
    sig      = sign(ci_lo95)==sign(ci_hi95),
    bias     = boot_mean - original,
    se_boot  = boot_sd
)

# ── TIPRED Bootstrap汇总 ──
tipred_boot_summary <- tipred_df %>%
    group_by(parameter, predictor, target) %>%
    summarise(
        boot_mean = mean(mean,          na.rm=TRUE),
        boot_sd   = sd(mean,            na.rm=TRUE),
        ci_lo95   = quantile(mean,.025, na.rm=TRUE),
        ci_hi95   = quantile(mean,.975, na.rm=TRUE),
        n_valid   = sum(!is.na(mean)),
        .groups   = "drop"
    ) %>%
    left_join(
        res_full$tipred %>% rename(original=mean) %>% select(parameter,original),
        by="parameter"
    ) %>%
    mutate(
        sig      = sign(ci_lo95)==sign(ci_hi95),
        bias     = boot_mean - original,
        se_boot  = boot_sd,
        # 稳定性标签
        dir_pct  = mapply(function(par, orig) {
            vals <- tipred_df$mean[tipred_df$parameter==par]
            if(length(vals)==0 || is.na(orig)) return(NA_real_)
            mean(sign(vals)==sign(orig), na.rm=TRUE)*100
        }, parameter, original),
        stability = case_when(
            dir_pct >= 90 ~ "高稳定",
            dir_pct >= 75 ~ "中稳定",
            TRUE          ~ "低稳定"
        )
    ) %>%
    arrange(target, predictor)

# =============================================================================
# 第5步：打印结果摘要
# =============================================================================
cat("\n══════════════════════════════════════════════════════\n")
cat("         DRIFT参数 Bootstrap结果（可发表）\n")
cat("══════════════════════════════════════════════════════\n")
cat(sprintf("%-12s  %8s  %8s  %7s  %20s  %s\n",
            "参数","原始值","Boot均","SE","Bootstrap 95%CI","显著"))
cat(paste(rep("─",72),collapse=""),"\n")
for(i in 1:nrow(drift_boot_summary)) {
    r <- drift_boot_summary[i,]
    cat(sprintf("%-12s  %8.4f  %8.4f  %7.4f  [%7.4f, %7.4f]  %s\n",
                r$parameter, r$original, r$boot_mean, r$se_boot,
                r$ci_lo95, r$ci_hi95,
                ifelse(r$sig,"✅ 显著","—")))
}

cat("\n══════════════════════════════════════════════════════\n")
cat("   TI预测变量效应 Bootstrap结果（可发表）\n")
cat("══════════════════════════════════════════════════════\n")

for(tgt in c("eta_P","eta_A")) {
    cat(sprintf("\n  目标变量：%s\n", ifelse(tgt=="eta_P","η_P（正向情绪）","η_A（负向情绪）")))
    cat(sprintf("  %-18s  %8s  %8s  %7s  %20s  %7s  %s\n",
                "预测变量","原始值","Boot均","SE","Bootstrap 95%CI","方向%","显著"))
    cat("  ",paste(rep("─",80),collapse=""),"\n")
    sub <- tipred_boot_summary %>% filter(target==tgt)
    for(i in 1:nrow(sub)) {
        r <- sub[i,]
        cat(sprintf("  %-18s  %8.4f  %8.4f  %7.4f  [%7.4f, %7.4f]  %6.0f%%  %s\n",
                    r$predictor,
                    ifelse(is.na(r$original),0,r$original),
                    r$boot_mean, r$se_boot,
                    r$ci_lo95, r$ci_hi95,
                    ifelse(is.na(r$dir_pct),0,r$dir_pct),
                    ifelse(r$sig,"✅","—")))
    }
}

