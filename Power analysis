# df = N - k - 1 = 22
# 使用 f² = r²_partial / (1 - r²_partial)

# 计算单变量t检验效力
calc_t_power <- function(f2_partial, N, k, alpha = 0.05) {
  df <- N - k - 1
  lambda <- f2_partial * (df + 1)  # 非中心参数近似
  t_crit <- qt(1 - alpha/2, df)
  power <- 1 - pt(t_crit, df, ncp = sqrt(lambda)) + pt(-t_crit, df, ncp = sqrt(lambda))
  return(power)
}

