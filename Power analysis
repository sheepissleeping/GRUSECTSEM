               "0.25", "Large (0.35)", "0.50", "0.75", "1.00")

# F检验效力计算函数
calc_f_power <- function(f2, df1, df2, alpha = 0.05) {
  lambda <- f2 * (df1 + df2 + 1)  # 非中心参数
  f_crit <- qf(1 - alpha, df1, df2)
  power <- 1 - pf(f_crit, df1, df2, ncp = lambda)
  return(power)
}

overall_power_table <- data.frame(
  f2 = f2_values,
  label = f2_labels,
  R2 = f2_values / (1 + f2_values),
  power = sapply(f2_values, calc_f_power, df1 = df1, df2 = df2, alpha = config$alpha)
)

