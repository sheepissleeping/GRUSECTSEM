# 不同效应量下达到80%效力所需的N
effect_sizes <- c(0.02, 0.05, 0.10, 0.15, 0.25, 0.35)
effect_labels <- c("Small", "", "", "Medium", "", "Large")

find_required_N <- function(target_f2, k, alpha, target_power) {
  for(n in (k+2):1000) {
    df2 <- n - k - 1
    power <- calc_f_power(target_f2, df1 = 1, df2 = df2, alpha = alpha)
    if(power >= target_power) return(n)
  }
  return(NA)
}

sample_size_table <- data.frame(
  f2 = effect_sizes,
  label = effect_labels,
  N_uncorrected = sapply(effect_sizes, find_required_N, 
                          k = config$n_predictors, 
                          alpha = config$alpha, 
                          target_power = config$target_power),
  N_bonferroni = sapply(effect_sizes, find_required_N, 
                         k = config$n_predictors, 
                         alpha = alpha_bonf, 
                         target_power = config$target_power)
)

cat("达到80%效力所需的样本量 (单个预测变量, k=7):\n\n")
