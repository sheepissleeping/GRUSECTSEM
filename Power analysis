# 找到80%效力对应的最小f²
# 二分搜索
find_mdes_f2 <- function(df1, df2, alpha, target_power) {
  lo <- 0.001; hi <- 5.0
  for(iter in 1:100) {
    mid <- (lo + hi) / 2
    p <- calc_f_power(mid, df1, df2, alpha)
    if(p < target_power) lo <- mid else hi <- mid
    if(abs(p - target_power) < 0.0001) break
  }
  return(mid)
}

