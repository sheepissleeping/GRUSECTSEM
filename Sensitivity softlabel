# 通用拟合函数
fit_ctsem_condition <- function(dat, condition_name, condition_counter) {
  cat(sprintf("\n───── 条件: %s ─────\n", condition_name))
  
  model_data <- prepare_ctsem_data(dat, std_params)
  cat(sprintf("  数据: %d个体, %d观测\n",
              length(unique(model_data$id)), nrow(model_data)))
  
  result <- tryCatch({
    ctsem_model <- ctModel(
      type = 'stanct',
      n.latent = 2, n.manifest = 2,
      LAMBDA = diag(2),
      manifestNames = c('P', 'A'),
      latentNames = c('eta_P', 'eta_A'),
      TIpredNames = ti_covs,
      id = 'id', time = 'time'
    )
    
    cat("  正在拟合...\n")
    start_time <- Sys.time()
    
    ctsem_fit <- ctStanFit(
      datalong = model_data,
      ctstanmodel = ctsem_model,
      optimize = TRUE,
      optimcontrol = list(stochastic = FALSE, finishsamples = 1000),
      cores = 1, nopriors = TRUE, verbose = 0
    )
    
    elapsed <- as.numeric(difftime(Sys.time(), start_time, units="mins"))
    cat(sprintf("  ✅ 完成 (%.1f分钟)\n", elapsed))
    
    model_summary <- summary(ctsem_fit)
    
    drift_params <- as.data.frame(model_summary$parmatrices) %>%
      filter(matrix == "DRIFT")
    
    drift_result <- data.frame(
      condition = condition_name,
      drift_PP = drift_params$Mean[drift_params$row == 1 & drift_params$col == 1],
      drift_AA = drift_params$Mean[drift_params$row == 2 & drift_params$col == 2],
      drift_PA = drift_params$Mean[drift_params$row == 2 & drift_params$col == 1],
      drift_AP = drift_params$Mean[drift_params$row == 1 & drift_params$col == 2],
      loglik = ifelse(!is.null(model_summary$loglik), model_summary$loglik, NA),
      aic = ifelse(!is.null(model_summary$aic), model_summary$aic, NA),
      n_obs = nrow(model_data),
      fit_time = elapsed
    )
    
    cat(sprintf("  DRIFT: P→P=%.4f, A→A=%.4f, P→A=%.4f, A→P=%.4f\n",
                drift_result$drift_PP, drift_result$drift_AA,
                drift_result$drift_PA, drift_result$drift_AP))
    
    # 提取TI预测变量效应
    tipred_result <- NULL
    if(!is.null(model_summary$tipreds)) {
      tipred_result <- as.data.frame(model_summary$tipreds)
      tipred_result$parameter <- rownames(tipred_result)
      if("Mean" %in% names(tipred_result)) tipred_result$mean <- tipred_result$Mean
      if("Sd" %in% names(tipred_result)) tipred_result$sd <- tipred_result$Sd
      if("2.5%" %in% names(tipred_result)) {
        tipred_result$ci_lower <- tipred_result$`2.5%`
        tipred_result$ci_upper <- tipred_result$`97.5%`
      }
      tipred_result$condition <- condition_name
      cat(sprintf("  ✅ 提取了%d个TI预测变量效应\n", nrow(tipred_result)))
    }
    
    list(drift = drift_result, tipred = tipred_result)
    
  }, error = function(e) {
    cat(sprintf("  ❌ 失败: %s\n", e$message))
    list(
      drift = data.frame(
        condition = condition_name,
        drift_PP = NA, drift_AA = NA, drift_PA = NA, drift_AP = NA,
        loglik = NA, aic = NA, n_obs = NA, fit_time = NA
      ),
      tipred = NULL
    )
  })
  
  return(result)
}

