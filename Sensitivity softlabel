# 对每个argmax标签，计算基于混淆矩阵概率的期望P和期望A
soft_pad <- data.frame(
  argmax_label = emotion_labels,
  original_P = pad_mapping$P,
  original_A = pad_mapping$A,
  soft_P = NA,
  soft_A = NA,
  stringsAsFactors = FALSE
