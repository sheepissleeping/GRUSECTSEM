# --- 运行条件3-N：蒙特卡洛采样 ---
for(mc_iter in 1:config$n_mc_iterations) {
  condition_counter <- condition_counter + 1
  mc_seed <- config$base_seed + mc_iter * 1000
  
  # 从混淆矩阵概率中采样标签
  dat_mc <- dat_baseline %>%
    mutate(
      sampled_label = sample_label_from_confusion(
        emotion_label, row_normalized, mc_seed
      ),
      P_sampled = P_lookup[as.character(sampled_label)],
      A_sampled = A_lookup[as.character(sampled_label)]
    )
  
  # 对采样后的P/A做移动平均
  dat_mc <- dat_mc %>%
    group_by(id) %>%
    arrange(time) %>%
    mutate(
      P_smooth = zoo::rollmean(P_sampled, k=config$smooth_window, fill="extend"),
      A_smooth = zoo::rollmean(A_sampled, k=config$smooth_window, fill="extend")
    ) %>%
    ungroup()
  
  # 统计标签变化
  changed <- mean(dat_mc$sampled_label != dat_mc$emotion_label)
  cat(sprintf("\n  蒙特卡洛#%d: %.1f%%标签被采样为不同类别\n", mc_iter, changed*100))
  
  condition_name <- sprintf("3_monte_carlo_%d", mc_iter)
  res <- fit_ctsem_condition(dat_mc, condition_name, condition_counter)
  all_results[[condition_counter]] <- res$drift
  if(!is.null(res$tipred)) all_tipred_results[[condition_counter]] <- res$tipred
}

