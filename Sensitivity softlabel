  dimnames = list(emotion_labels, emotion_labels)
)

# 行归一化：得到 P(实际类别 | argmax标签)
# 注意：这里的解释是"当argmax输出为X时，真实类别的概率分布"
# 但混淆矩阵的行是"真实=X时，预测的分布"
# 我们需要的是"预测=X时，真实的分布" → 需要用列归一化（贝叶斯反转）
# 
# 但在敏感性分析的语境下，两种解读都合理：
#   解读A（行归一化）：模型对类别X的样本，实际会产生什么标签分布
#   解读B（列归一化）：当模型输出X时，真实类别的后验分布
#
# 这里我们同时计算两种，主分析用行归一化（更保守，直接反映分类器行为）

# 行归一化：P(predicted | true = X)
row_normalized <- confusion_raw / rowSums(confusion_raw)

cat("混淆矩阵（原始计数）：\n")
print(confusion_raw)
cat("\n行归一化（P(predicted | true)）：\n")
print(round(row_normalized, 3))
cat("\n")

# 列归一化：P(true | predicted = X)（贝叶斯后验）
col_sums <- colSums(confusion_raw)
col_sums[col_sums == 0] <- 1  # 避免除零（sad列全为0）
col_normalized <- t(t(confusion_raw) / col_sums)

cat("列归一化（P(true | predicted)，贝叶斯后验）：\n")
print(round(col_normalized, 3))
cat("\n")

