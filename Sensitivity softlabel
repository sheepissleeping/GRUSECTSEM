# 混淆矩阵（行=真实/argmax标签，列=实际可能的类别）
# 来源：seed=42, epoch 111, WA=64.96%
confusion_raw <- matrix(
  c(20, 0, 2, 0, 1, 0, 0,   # hap
    1,  0, 1, 0, 2, 0, 1,   # sad
    0,  0, 51,0, 0, 0, 1,   # neu
