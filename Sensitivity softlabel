  soft_pad$soft_P[i] <- sum(probs * pad_mapping$P)
  soft_pad$soft_A[i] <- sum(probs * pad_mapping$A)
}

soft_pad$P_diff <- soft_pad$soft_P - soft_pad$original_P
soft_pad$A_diff <- soft_pad$soft_A - soft_pad$original_A

cat("argmax标签 vs 软标签的P/A值对比：\n")
cat("（软标签 = 混淆矩阵概率加权平均）\n\n")
