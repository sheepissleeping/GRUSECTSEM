# 蒙特卡洛采样函数
sample_label_from_confusion <- function(argmax_label, confusion_probs, seed) {
  set.seed(seed)
  n <- length(argmax_label)
  sampled <- character(n)
  
  for(i in 1:n) {
    label <- as.character(argmax_label[i])
    label_idx <- match(label, emotion_labels)
    probs <- confusion_probs[label_idx, ]
    
    # 从混淆矩阵概率分布中采样一个标签
    sampled[i] <- sample(emotion_labels, 1, prob = probs)
  }
  
  return(factor(sampled, levels = emotion_labels))
}

