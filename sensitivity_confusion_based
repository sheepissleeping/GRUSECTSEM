cat("═══════════════════════════════════════════════════════════════════\n\n")

all_drift <- list()
all_tipred <- list()
all_diagnostics <- list()
counter <- 0

for(scale in config$noise_scales) {
  
  n_iter <- ifelse(scale == 0, 1, config$n_iterations)
  
  for(iter in 1:n_iter) {
    counter <- counter + 1
    seed <- config$base_seed + counter * 100
    
    condition_name <- sprintf("scale_%.2f_iter_%d", scale, iter)
    cat(sprintf("\n── 缩放因子=%.2f, 迭代=%d ──\n", scale, iter))
    
    if(scale == 0) {
      # 基线：不加噪声，直接使用原始数据
      dat_noised <- dat_baseline
      diag_info <- data.frame(
        condition = condition_name, scale = scale, iter = iter,
        n_flipped = 0, flip_rate = 0
      )
    } else {
      # 基于混淆矩阵注入噪声
      flip_result <- add_confusion_noise(
        dat_raw$emotion_label, scale, error_rates, misclass_probs, seed
      )
      
      cat(sprintf("  翻转: %d帧 (%.1f%%)\n", 
                  flip_result$n_flipped, flip_result$flip_rate * 100))
      
      # 用翻转后的标签重新查PAD表
      dat_noised <- dat_raw %>%
        mutate(
          emotion_label = flip_result$labels,
          P = pad_P[as.character(emotion_label)],
          A = pad_A[as.character(emotion_label)]
        )
      
      # 3点移动平均（与原始分析一致！）
      dat_noised <- dat_noised %>%
        group_by(id) %>%
        arrange(time) %>%
        mutate(
          P_smooth = zoo::rollmean(P, k = config$smooth_window, fill = "extend"),
          A_smooth = zoo::rollmean(A, k = config$smooth_window, fill = "extend")
        ) %>%
        ungroup()
      
      diag_info <- data.frame(
        condition = condition_name, scale = scale, iter = iter,
        n_flipped = flip_result$n_flipped,
        flip_rate = flip_result$flip_rate
      )
    }
    
    all_diagnostics[[counter]] <- diag_info
    
    # 标准化并拟合CTSEM
    model_data <- prepare_and_standardize(dat_noised, std_params)
    res <- fit_ctsem(model_data, condition_name)
    all_drift[[counter]] <- res$drift
    if(!is.null(res$tipred)) all_tipred[[counter]] <- res$tipred
  }
}

