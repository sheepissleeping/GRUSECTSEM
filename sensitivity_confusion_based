)

# =============================================================================
# 第5步：核心函数 — 基于混淆矩阵的噪声注入
# =============================================================================
add_confusion_noise <- function(emotion_vec, scale, error_rates, misclass_matrix, seed) {
  set.seed(seed)
  n <- length(emotion_vec)
  noised <- as.character(emotion_vec)
  n_flipped <- 0
  
  for(i in 1:n) {
    label <- noised[i]
    label_idx <- match(label, emotion_labels)
    
    # 该类别的经验错误率 × 缩放因子 = 翻转概率
    flip_prob <- error_rates[label_idx] * scale
    flip_prob <- min(flip_prob, 1.0)
    
    if(runif(1) < flip_prob) {
      target_probs <- misclass_matrix[label_idx, ]
      if(sum(target_probs) > 0) {
        noised[i] <- sample(emotion_labels, 1, prob = target_probs)
        n_flipped <- n_flipped + 1
      }
    }
  }
  
  list(
    labels = factor(noised, levels = emotion_labels),
    n_flipped = n_flipped,
    flip_rate = n_flipped / n
  )
}

# =============================================================================
# 第6步：CTSEM数据准备和拟合函数
# =============================================================================
prepare_and_standardize <- function(dat, std_params) {
  dat %>%
    mutate(
      P_std = (P_smooth - std_params$P_mean) / std_params$P_sd,
      A_std = (A_smooth - std_params$A_mean) / std_params$A_sd,
      age_z = (age - std_params$age_mean) / std_params$age_sd,
      gender_c = gender - std_params$gender_mean,
      Extraversion_z = (Extraversion - std_params$E_mean) / std_params$E_sd,
      Agreeableness_z = (Agreeableness - std_params$Agr_mean) / std_params$Agr_sd,
      Conscientiousness_z = (Conscientiousness - std_params$Con_mean) / std_params$Con_sd,
      Neuroticism_z = (Neuroticism - std_params$Neu_mean) / std_params$Neu_sd,
      Openness_z = (Openness - std_params$Ope_mean) / std_params$Ope_sd
    ) %>%
    select(id, time, P_std, A_std, age_z, gender_c,
           Extraversion_z, Agreeableness_z, Conscientiousness_z,
           Neuroticism_z, Openness_z) %>%
    rename(P = P_std, A = A_std,
           age = age_z, gender = gender_c,
           Extraversion = Extraversion_z, Agreeableness = Agreeableness_z,
           Conscientiousness = Conscientiousness_z,
           Neuroticism = Neuroticism_z, Openness = Openness_z) %>%
    group_by(id) %>% filter(n() >= 3) %>% ungroup() %>%
    as.data.frame()
}

ti_covs <- c("age", "gender", "Extraversion", "Agreeableness",
             "Conscientiousness", "Neuroticism", "Openness")

fit_ctsem <- function(model_data, condition_name) {
  cat(sprintf("  拟合 %s ... ", condition_name))
  
  tryCatch({
    ctsem_model <- ctModel(
      type = 'stanct',
      n.latent = 2, n.manifest = 2,
      LAMBDA = diag(2),
      manifestNames = c('P', 'A'),
      latentNames = c('eta_P', 'eta_A'),
      TIpredNames = ti_covs,
      id = 'id', time = 'time'
    )
    
    start_time <- Sys.time()
    ctsem_fit <- ctStanFit(
      datalong = model_data,
      ctstanmodel = ctsem_model,
      optimize = TRUE,
      optimcontrol = list(stochastic = FALSE, finishsamples = 1000),
      cores = 1, nopriors = TRUE, verbose = 0
    )
    elapsed <- as.numeric(difftime(Sys.time(), start_time, units = "mins"))
    
    s <- summary(ctsem_fit)
    drift <- as.data.frame(s$parmatrices) %>% filter(matrix == "DRIFT")
    
    cat(sprintf("✅ (%.1f分钟)\n", elapsed))
    
    drift_result <- data.frame(
      condition = condition_name,
      drift_PP = drift$Mean[drift$row == 1 & drift$col == 1],
      drift_AA = drift$Mean[drift$row == 2 & drift$col == 2],
      drift_PA = drift$Mean[drift$row == 2 & drift$col == 1],
      drift_AP = drift$Mean[drift$row == 1 & drift$col == 2],
      fit_time = elapsed
    )
    
    tipred_result <- NULL
    if(!is.null(s$tipreds)) {
      tipred_result <- as.data.frame(s$tipreds)
      tipred_result$parameter <- rownames(tipred_result)
      if("Mean" %in% names(tipred_result)) tipred_result$mean <- tipred_result$Mean
      tipred_result$condition <- condition_name
    }
    
    list(drift = drift_result, tipred = tipred_result)
    
  }, error = function(e) {
    cat(sprintf("❌ %s\n", e$message))
    list(
      drift = data.frame(condition = condition_name,
                          drift_PP = NA, drift_AA = NA, drift_PA = NA, drift_AP = NA,
                          fit_time = NA),
      tipred = NULL
    )
  })
}

